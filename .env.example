# Copy this file to .env and fill it in.   (PowerShell: Copy-Item .env.example .env)
# In production the API refuses to start while the secret or the database password below
# are still the examples.

# ---------- Database ----------
# Use letters, digits, - and _ only in the password (it is also placed inside a URL).
POSTGRES_USER=gs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gs_command_center
DATABASE_URL=postgresql://gs:change_me@localhost:5432/gs_command_center
# Integration tests use a separate database (created automatically if missing).
DATABASE_URL_TEST=postgresql://gs:change_me@localhost:5432/gs_test

# ---------- API ----------
NODE_ENV=development
PORT=4000
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string_at_least_40_chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# The address staff open in the browser.
CORS_ORIGIN=http://localhost:5173
# true when the site is served over HTTPS.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (Caddy on a VPS = 1).
TRUST_PROXY=0
LOG_LEVEL=info
BUSINESS_TIMEZONE=Asia/Phnom_Penh
# Team chat messages older than this many days are deleted (0 = keep).
CHAT_RETENTION_DAYS=7

# ---------- Files ----------
# Relative paths are resolved from the project folder.
UPLOAD_DIR=./storage
# Production (PM2): the built website the API serves itself.
# WEB_DIST_DIR=client/dist
# Backups (pnpm backup). PG_BIN only on Windows, e.g. C:\Program Files\PostgreSQL\18\bin
BACKUP_DIR=./backups
# PG_BIN=

# ---------- Demo data (development only) ----------
# Password given to the demo accounts by `pnpm db:seed`.
SEED_DEFAULT_PASSWORD=change_me_demo_pw

# ---------- Ask AI assistant ----------
# Keys stay on the server. Leave both empty to turn the assistant off.
# AI_PROVIDER: anthropic or gemini (empty = whichever has a key, Claude first).
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# ---------- Rates sync (Settings → Rates) ----------
# Set to false on servers without internet.
EXCHANGE_RATE_SYNC=true
FUEL_PRICE_SYNC=true
METAL_PRICE_SYNC=true

# ---------- Docker ----------
POSTGRES_PORT=5432
WEB_PORT=8080
PUBLIC_URL=http://localhost:8080
# Production with HTTPS (deploy/docker-compose.prod.yml): the domain pointed at this server.
# DOMAIN=ops.your-domain.com
