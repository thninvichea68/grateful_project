# Copy this file to .env and change the secrets.  (PowerShell: Copy-Item .env.example .env)

# ---------- Database ----------
# Use letters, digits, - and _ only in the password (it is also placed inside a URL).
POSTGRES_USER=gs
POSTGRES_PASSWORD=grateful@2024
POSTGRES_DB=gs_command_center
# Local dev (API on your machine, Postgres in Docker on port 5432):
DATABASE_URL=postgresql://gs:MyDbPass_2026@localhost:5432/gs_command_center
# Integration tests use a separate database (created automatically if missing):
DATABASE_URL_TEST=postgresql://gs:MyDbPass_2026@localhost:5432/gs_command_center_test
# ---------- API ----------
NODE_ENV=development
PORT=4000
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGIN=http://localhost:5173
# Set to true when served over HTTPS
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (1 behind nginx in docker compose)
TRUST_PROXY=0
LOG_LEVEL=info
UPLOAD_DIR=./storage
BUSINESS_TIMEZONE=Asia/Phnom_Penh

# ---------- Docker ----------
# Host ports and the public address used by the browser
POSTGRES_PORT=5432
WEB_PORT=8080
PUBLIC_URL=http://localhost:8080

# ---------- Seed ----------
# Password given to the seeded demo users (pnpm db:seed). Min 10 chars.
SEED_DEFAULT_PASSWORD=ChangeMe-2026!
