{
  "name": "gs-command-center",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gs/api --filter @gs/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @gs/api db:generate",
    "db:migrate": "pnpm --filter @gs/api db:migrate",
    "db:seed": "pnpm --filter @gs/api db:seed",
    "db:reset": "pnpm --filter @gs/api db:reset",
    "db:studio": "pnpm --filter @gs/api db:studio",
    "docker:seed": "docker compose exec api node dist/db/seed/index.js --force"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "type": "module"
}
